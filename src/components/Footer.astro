---
import { i18n } from "../lib/i18n";
const { t, href } = i18n(Astro.url);
import { site } from "../data/site";
---
<footer class="v3-footer">
				<nav aria-label={t("Contact and more", "Contatti e altre pagine")}>
					<a href={`mailto:${site.email}`} data-email={site.email}>Email</a>
					<a href={site.github}>GitHub</a>
                    <a href={site.linkedin}>LinkedIn</a>
					<a href="/rss.xml">RSS</a>
                    <a href={href("/about")}>{t("Profile", "Profilo")}</a>
					<a href={href("/uses")} >{t("Uses", "Strumenti")}</a>
<a href={href("/changelog")} >{t("Changelog", "Aggiornamenti")}</a>
				</nav>
				<button class="sound v3-sound" type="button" aria-label={t("Toggle sound", "Attiva o disattiva i suoni")} aria-pressed="false">
					<span aria-hidden="true">♪</span><span class="v3-sound-off">{t("Sound off", "Suoni disattivati")}</span><span class="v3-sound-on">{t("Sound on", "Suoni attivi")}</span>
				</button>
			</footer>
