---
import { i18n } from "../lib/i18n";
const { locale, t, href } = i18n(Astro.url);
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import Row from "../components/Row.astro";
import DataPlate from "../components/DataPlate.astro";
import { getNotes, noteMeta, getProjects } from "../lib/content";
import { nowItems } from "../lib/now";
import { site } from "../data/site";
const [notes, currentNow, projects] = await Promise.all([getNotes(), nowItems(locale), getProjects(locale)]);
const now = [{ label: t("studying", "studio"), value: t("Computer and control engineering · Sapienza · second year", "Ingegneria informatica e automatica · Sapienza · secondo anno") }, ...currentNow];
const [firstName, ...surname] = site.name.split(" ");
---
<Base title={site.name} description={t(site.description, "Ingegneria informatica e automatica alla Sapienza. Un diario di ciò che costruisco e imparo.")} home>
<header class="v3-intro enter">
				<div id="v3-copy">
					<h1>{firstName} <span class="v3-sketch-name">{surname.join(" ")}<svg class="v3-sketch v3-name-stroke" viewBox="0 0 112 13" aria-hidden="true"><path d="M3 8C25 5 52 9 76 6S99 5 109 6" /><path d="M9 11C30 8 49 10 68 9" opacity=".35" /></svg></span></h1>
                    <p>{t("I'm Tommaso, a computer and control engineering student at Sapienza University of Rome, starting my second year.", "Sono Tommaso, studio ingegneria informatica e automatica alla Sapienza di Roma e sto iniziando il secondo anno.")}</p>
                    <p>{t("This is where I document what I build and learn. I'm interested in mathematics, cybersecurity, and AI, especially running it locally. Outside programming, I ride horses.", "Qui documento ciò che costruisco e imparo. Mi interessano la matematica, la cybersecurity e l'AI, soprattutto locale. Fuori dalla programmazione, vado a cavallo.")}</p>
                    <p><a href={href("/about")}>{t("Education, experience, and recognition", "Formazione, esperienze e riconoscimenti")}</a></p>
				</div>
			</header>

			<section class="v3-section enter" aria-labelledby="v3-projects" style="--i:1">
				<h2 id="v3-projects">{t("Projects", "Progetti")}</h2>
				<div>
                    <div class="rows">
                        {projects.map((project) => (
                            <Row href={href(`/projects/${project.id.replace(/^it\//, "")}`)} title={project.data.title} description={project.data.summary} meta={String(project.data.year)} vt={`project-${project.id}`} />
                        ))}
                    </div>
                    <a class="v3-more" href={href("/projects")} >{t("All projects", "Tutti i progetti")}</a>
                </div>
			</section>

			<section class="v3-section enter" aria-labelledby="v3-notes" style="--i:2">
				<h2 id="v3-notes">{t("Notes", "Appunti")}</h2>
				<div>
					<div class="rows v3-notes">
						{notes.slice(0, 3).map((note) => (
							<Row href={`/notes/${note.id}`} title={note.data.title} meta={locale === "it" ? "In inglese" : noteMeta(note)} />
						))}
					</div>
					<a class="v3-more" href={href("/notes")} >{t("All notes", "Tutti gli appunti")}</a>
				</div>
			</section>

			<section class="v3-section enter" aria-labelledby="v3-now" style="--i:3">
				<h2 id="v3-now"><span class="v3-sketch-label">{t("Now", "Ora")}<svg class="v3-sketch v3-pencil-circle" viewBox="0 0 76 40" aria-hidden="true"><path d="M62 10C49 1 16 2 7 15C-1 29 26 37 51 33C72 29 75 13 61 8C45 3 24 5 16 9" /><path d="M61 31L70 36" opacity=".5" /></svg></span></h2>
				<div>
					<DataPlate items={now} />
				</div>
			</section>

<Footer slot="footer" />
</Base>
