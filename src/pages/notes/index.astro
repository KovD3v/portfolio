---
import { i18n } from "../../lib/i18n";
const { locale, t, href } = i18n(Astro.url);
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import Row from "../../components/Row.astro";
import { getNotes, noteMeta } from "../../lib/content";
import { site } from "../../data/site";
const notes = await getNotes();
---

<Base
	title={`${t("Notes", "Appunti")} — ${site.name}`}
	description={t("Short writeups on systems, Linux, and things that broke.", "Appunti su ciò che studio e imparo.")}>
	<a class="back" href={href("/")} >{t("home", "inizio")}</a>
	<h1 class="page-title">{t("Notes", "Appunti")}</h1>
	<p class="lead">
		{t("Short writeups on what I'm learning \u2014 mostly systems, mostly things that\n\t\tbroke first. Each one carries a status: seedling, growing, or evergreen.", "Appunti su ciò che sto imparando. Gli articoli disponibili solo in inglese si aprono nella sezione inglese.")}
	</p>
	<div class="rows enter" style="--i: 1">
		{
			notes.map((n) => (
				<Row
					href={`/notes/${n.id}`}
					title={n.data.title}
					meta={locale === "it" ? "In inglese" : noteMeta(n)}
					vt={`note-${n.id}`}
				/>
			))
		}
	</div>
	<a class="v3-more" href="/rss.xml">RSS</a>
	<Footer slot="footer" />
</Base>
